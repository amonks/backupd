package main

import (
	"fmt"
	"monks.co/backupd/config"
	"monks.co/backupd/history"
	"monks.co/backupd/logger"
	"monks.co/backupd/model"
	"monks.co/backupd/sync"
	"strings"
	"time"
)

templ index(state *model.Model, globalLogs []logger.LogEntry, syncStatus *sync.Status, hist *history.History, dataset string, dryrun bool, conf *config.Config) {
	<!DOCTYPE html>
	<html>
		<head>
			<title>backupd</title>
			<style>
				body {
					font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
					margin: 0;
					padding: 0;
					display: flex;
					height: 100vh;
				}
				.dryrun-banner {
					background-color: #ff9800;
					color: white;
					text-align: center;
					padding: 0.5rem;
					position: fixed;
					top: 0;
					left: 0;
					right: 0;
					z-index: 1000;
					font-weight: bold;
				}
				body.dryrun-active {
					padding-top: 2.5rem;
				}
				.paused-banner {
					background-color: #607d8b;
					color: white;
					text-align: center;
					padding: 0.5rem;
					position: fixed;
					top: 0;
					left: 0;
					right: 0;
					z-index: 1000;
					font-weight: bold;
				}
				body.paused-active {
					padding-top: 2.5rem;
				}
				body.dryrun-active .paused-banner {
					top: 2.5rem;
				}
				body.dryrun-active.paused-active {
					padding-top: 5rem;
				}
				.controls {
					display: flex;
					flex-direction: column;
					gap: 0.4rem;
					margin: 0.5rem 0 1rem 0;
				}
				.controls .snapshot-row {
					display: flex;
					gap: 0.4rem;
				}
				.controls .snapshot-row select {
					flex: 1;
					min-width: 0;
				}
				.btn {
					padding: 0.35rem 0.7rem;
					border: 1px solid #bbb;
					border-radius: 4px;
					background-color: white;
					cursor: pointer;
					font-size: 0.85rem;
				}
				.btn:hover {
					background-color: #eee;
				}
				.btn.warn {
					border-color: #607d8b;
					color: #607d8b;
					font-weight: 500;
				}
				.dataset-controls {
					display: flex;
					gap: 0.5rem;
					margin-bottom: 1rem;
				}
				.paused-label {
					color: #607d8b;
					font-weight: 500;
				}
				.cycle-ok {
					color: #4caf50;
					font-weight: bold;
				}
				.cycle-failed {
					color: #f44336;
					font-weight: bold;
				}
				.cycle-paused {
					color: #607d8b;
					font-weight: bold;
				}
				#config-editor {
					width: 100%;
					min-height: 24rem;
					font-family: monospace;
					font-size: 0.9rem;
					padding: 0.75rem;
					border: 1px solid #ccc;
					border-radius: 4px;
					box-sizing: border-box;
					resize: vertical;
				}
				.config-actions {
					display: flex;
					gap: 0.5rem;
					margin: 0.75rem 0;
				}
				.config-error {
					background-color: #ffebee;
					color: #c62828;
					padding: 0.75rem;
					border-radius: 4px;
					white-space: pre-wrap;
					font-family: monospace;
					font-size: 0.85rem;
				}
				.impact-note {
					color: #666;
					font-size: 0.9rem;
				}
				.sidebar {
					width: 250px;
					background-color: #f5f5f5;
					border-right: 1px solid #ddd;
					padding: 1rem;
					overflow-y: auto;
				}
				.sidebar h2 {
					margin-top: 0;
					font-size: 1.2rem;
				}
				.main-content {
					flex: 1;
					padding: 1rem;
					overflow-y: auto;
				}
				.dataset-link {
					display: flex;
					align-items: flex-start;
					padding: 0.5rem;
					text-decoration: none;
					color: #333;
					border-radius: 4px;
					margin-bottom: 0.25rem;
					gap: 0.5rem;
				}
				.dataset-link:hover, .dataset-link.active {
					background-color: #e0e0e0;
				}
				.dataset-link .status {
					margin-left: auto;
					font-size: 0.8rem;
					color: #666;
					flex-shrink: 0;
				}
				.dataset-link .status.stale {
					color: #f44336;
				}
				.dataset-info {
					display: flex;
					flex-direction: column;
					gap: 0.2rem;
					flex-grow: 1;
					min-width: 0;
				}
				.dataset-name {
					font-weight: 500;
				}
				.dataset-size {
					font-size: 0.75rem;
					color: #666;
				}
				.sync-indicator {
					width: 12px;
					height: 12px;
					border-radius: 50%;
					flex-shrink: 0;
					margin-top: 0.1rem;
				}
				.sync-indicator.syncing {
					background: linear-gradient(45deg, #2196f3, #64b5f6);
					animation: pulse 1.5s ease-in-out infinite alternate;
				}
				.sync-indicator.synced {
					background-color: #4caf50;
				}
				.sync-indicator.stale {
					background-color: #ff9800;
				}
				.sync-indicator.paused {
					background-color: #9e9e9e;
				}
				@keyframes pulse {
					from { opacity: 0.6; }
					to { opacity: 1; }
				}
				@keyframes spin {
					from { transform: rotate(0deg); }
					to { transform: rotate(360deg); }
				}
				.step-status {
					display: inline-block;
					width: 16px;
					height: 16px;
					margin-right: 8px;
					vertical-align: middle;
				}
				.step-status.pending {
					border: 2px solid #ccc;
					border-radius: 50%;
				}
				.step-status.in-progress {
					border: 2px solid #2196f3;
					border-top: 2px solid transparent;
					border-radius: 50%;
					animation: spin 1s linear infinite;
				}
				.step-status.completed::before {
					content: '✓';
					color: #4caf50;
					font-weight: bold;
				}
				.step-status.failed::before {
					content: '✗';
					color: #f44336;
					font-weight: bold;
				}
				table {
					width: 100%;
					border-collapse: collapse;
					margin-bottom: 1rem;
				}
				th, td {
					padding: .2em 1em;
					text-align: left;
					border-bottom: 1px solid #ddd;
				}
				th {
					font-weight: bold;
				}
				th.sortable {
					cursor: pointer;
					user-select: none;
					position: relative;
				}
				th.sortable:hover {
					background-color: #f0f0f0;
				}
				th.sortable::after {
					content: '↕';
					position: absolute;
					right: 0.5rem;
					opacity: 0.3;
					font-size: 0.8em;
				}
				th.sortable.sort-asc::after {
					content: '↑';
					opacity: 0.8;
				}
				th.sortable.sort-desc::after {
					content: '↓';
					opacity: 0.8;
				}
				th.sortable:hover::after {
					opacity: 0.6;
				}
				.logs {
					background-color: #f9f9f9;
					padding: 1rem;
					border-radius: 4px;
					margin-top: 1rem;
				}
				.logs h2 {
					margin-top: 0;
				}
				.logs ul {
					list-style-type: none;
					padding: 0;
					margin: 0;
				}
				.logs li {
					padding: 0.25rem 0;
					font-family: monospace;
				}
				.plan-logs {
					background-color: #f0f8ff;
					padding: 1rem;
					border-radius: 4px;
					margin-bottom: 1rem;
				}
				.plan-logs h3 {
					margin-top: 0;
					font-size: 1rem;
					color: #2196f3;
				}
				.plan-logs ul {
					list-style-type: none;
					padding: 0;
					margin: 0;
				}
				.plan-logs li {
					padding: 0.25rem 0;
					font-family: monospace;
				}
				.step-log {
					background-color: #f9f9f9;
				}
				.log-cell {
					padding-left: 2rem !important;
				}
				.log-message {
					font-size: 0.85rem;
					color: #666;
					font-family: monospace;
					display: block;
					padding: 0.2rem 0;
				}
				.snapshot-table th, .snapshot-table td {
					text-align: center;
				}
				.snapshot-present {
					color: #4caf50;
				}
				.snapshot-absent {
					color: #f44336;
				}
				.snapshot-doomed {
					color: #ff9800;
				}
				.retention-override {
					color: #ff9800;
					font-weight: 500;
				}
			</style>
		</head>
		<body class={ templ.KV("dryrun-active", dryrun), templ.KV("paused-active", conf.Paused) }>
			if dryrun {
				<div class="dryrun-banner">DRY RUN MODE - No actual transfers or deletions will occur</div>
			}
			if conf.Paused {
				<div class="paused-banner">PAUSED - State is refreshed and planned, but nothing executes</div>
			}
			<div class="sidebar">
				<h2>System</h2>
				<a href="/global" class={ "dataset-link", templ.KV("active", dataset == "global") }>
					<div class="dataset-info">
						<div class="dataset-name">Global Overview</div>
					</div>
				</a>
				<a href="/config" class={ "dataset-link", templ.KV("active", dataset == "config") }>
					<div class="dataset-info">
						<div class="dataset-name">Config</div>
					</div>
				</a>
				<div class="controls">
					if conf.Paused {
						<button class="btn warn" data-api="/api/resume">Resume all</button>
					} else {
						<button class="btn" data-api="/api/pause" data-confirm="Pause all execution? State keeps refreshing, but no transfers or deletions run, and the dead-man's-snitch ping is withheld.">Pause all</button>
					}
					<button class="btn" data-api="/api/sync">Sync now</button>
					<div class="snapshot-row">
						<select id="snapshot-periodicity">
							<option value="daily">daily</option>
							<option value="weekly">weekly</option>
							<option value="monthly">monthly</option>
							<option value="yearly">yearly</option>
						</select>
						<button class="btn" id="snapshot-btn">Snapshot</button>
					</div>
				</div>
				<h2>Datasets</h2>
				for _, ds := range state.ListDatasets() {
					@renderDatasetLink(ds, state.Datasets[ds], syncStatus, conf, dataset)
				}
			</div>
			<div class="main-content">
				if dataset == "global" {
					<h1>backupd Overview</h1>
					<table>
						<thead>
							<tr>
								<th class="sortable">dataset</th>
								<th class="sortable">staleness</th>
								<th>retention</th>
								<th>sync status</th>
								<th>local</th>
								<th class="sortable">local disk</th>
								<th class="sortable">local logical</th>
								<th>remote</th>
								<th class="sortable">remote disk</th>
								<th class="sortable">remote logical</th>
							</tr>
						</thead>
						<tbody>
							for _, ds := range state.ListDatasets() {
								<tr>
									<td>{ ds.String() }</td>
									<td>{ state.Datasets[ds].Staleness().Truncate(time.Minute).String() }</td>
									<td>
										@renderRetention(conf, ds.Path())
									</td>
									<td>@renderSyncIndicator(ds, state.Datasets[ds], syncStatus, conf.PausedFor(ds.Path()))
</td>
									<td><code>{ state.Datasets[ds].Current.LocalString() }</code></td>
									<td><code>{ state.Datasets[ds].Metrics.LocalUsedString() }</code></td>
									<td><code>{ state.Datasets[ds].Metrics.LocalLogicalString() }</code></td>
									<td><code>{ state.Datasets[ds].Current.RemoteString() }</code></td>
									<td><code>{ state.Datasets[ds].Metrics.RemoteUsedString() }</code></td>
									<td><code>{ state.Datasets[ds].Metrics.RemoteLogicalString() }</code></td>
								</tr>
							}
						</tbody>
					</table>
					if cycles := hist.Cycles(); len(cycles) > 0 {
						<h2>Cycle History</h2>
						<table>
							<thead>
								<tr>
									<th>Started</th>
									<th>Duration</th>
									<th>Result</th>
									<th>Datasets</th>
									<th>Detail</th>
								</tr>
							</thead>
							<tbody>
								for _, c := range cycles {
									<tr>
										<td>{ c.StartedAt.Format(time.DateTime) }</td>
										<td>{ c.Duration().Round(time.Second).String() }</td>
										<td>
											if c.Paused {
												<span class="cycle-paused">paused</span>
											} else if c.OK {
												<span class="cycle-ok">ok</span>
											} else {
												<span class="cycle-failed">failed</span>
											}
										</td>
										<td>{ fmt.Sprint(c.Datasets) }</td>
										<td>
											if c.Error != "" {
												<code>{ c.Error }</code>
											} else if len(c.Failures) > 0 {
												<code>failed: { strings.Join(c.Failures, ", ") }</code>
											}
										</td>
									</tr>
								}
							</tbody>
						</table>
					}
					// Display global logs on the overview page
					if len(globalLogs) > 0 {
						<section class="logs">
							<h2>Global Logs</h2>
							<ul>
								for _, log := range globalLogs {
									<li><code>{ log.LogAt.Format(time.DateTime) } :: { log.Log }</code></li>
								}
							</ul>
						</section>
					}
				} else if dataset == "config" {
					<h1>Config</h1>
					<p class="impact-note">
						Editing <code>{ conf.Path }</code>. Preview validates the file and shows
						what would change — per dataset — before anything is written. Saving
						applies immediately: retention, pause, and interval changes take effect
						without a restart.
					</p>
					<textarea id="config-editor" spellcheck="false">{ string(conf.Raw) }</textarea>
					<div class="config-actions">
						<button class="btn" id="config-preview">Preview changes</button>
						<button class="btn warn" id="config-save">Save &amp; apply</button>
					</div>
					<div id="config-impacts"></div>
				} else {
					<h1>Dataset: { dataset }</h1>
					if ds, ok := state.Datasets[model.DatasetName(dataset)]; ok {
						<div>
							<div class="dataset-controls">
								if conf.SubtreePaused(dataset) {
									<button class="btn warn" data-api={ "/api/resume?dataset=" + dataset }>Resume dataset</button>
								} else if dataset != "" {
									<button class="btn" data-api={ "/api/pause?dataset=" + dataset } data-confirm={ "Pause syncing for " + dataset + " and everything under it?" }>Pause dataset</button>
								}
								<button class="btn" data-api={ "/api/sync?dataset=" + dataset }>Sync now</button>
							</div>
							<h2>Status</h2>
							<table>
								<tr>
									<th>Local snapshots</th>
									<td><code>{ ds.Current.LocalString() }</code></td>
								</tr>
								<tr>
									<th>Local disk size</th>
									<td><code>{ ds.Metrics.LocalUsedString() }</code></td>
								</tr>
								<tr>
									<th>Local logical size</th>
									<td><code>{ ds.Metrics.LocalLogicalString() }</code></td>
								</tr>
								<tr>
									<th>Remote snapshots</th>
									<td><code>{ ds.Current.RemoteString() }</code></td>
								</tr>
								<tr>
									<th>Remote disk size</th>
									<td><code>{ ds.Metrics.RemoteUsedString() }</code></td>
								</tr>
								<tr>
									<th>Remote logical size</th>
									<td><code>{ ds.Metrics.RemoteLogicalString() }</code></td>
								</tr>
								<tr>
									<th>Staleness</th>
									<td>{ ds.Staleness().Truncate(time.Minute).String() }</td>
								</tr>
								<tr>
									<th>Retention</th>
									<td>
										@renderRetention(conf, dataset)
									</td>
								</tr>
								if conf.PausedFor(dataset) {
									<tr>
										<th>Paused</th>
										<td>
											if conf.Paused {
												<span class="paused-label">yes (global pause)</span>
											} else {
												<span class="paused-label">yes</span>
											}
										</td>
									</tr>
								}
								if lastSuccess, ok := hist.LastSuccess(model.DatasetName(dataset)); ok {
									<tr>
										<th>Last successful sync</th>
										<td>{ lastSuccess.Format(time.DateTime) }</td>
									</tr>
								}
							</table>
							if ds.Plan != nil && len(ds.Plan.Steps) > 0 {
								<h2>Sync Plan</h2>
								// Display plan-level logs if any
								if ds.Logs != nil && len(ds.Logs.GetLogs()) > 0 {
									<div class="plan-logs">
										<h3>Plan Setup</h3>
										<ul>
											for _, log := range ds.Logs.GetLogs() {
												<li><code>{ log.LogAt.Format("15:04:05") } { log.Log }</code></li>
											}
										</ul>
									</div>
								}
								<table>
									<thead>
										<tr>
											<th>#</th>
											<th>Status</th>
											<th>Operation</th>
											<th>Started</th>
											<th>Stopped</th>
											<th>Duration</th>
										</tr>
									</thead>
									<tbody>
										for i, step := range ds.Plan.Steps {
											<tr>
												<td>{ fmt.Sprint(i + 1) }</td>
												<td>
													@renderStepStatus(step.Status)
												</td>
												<td><code>{ step.String() }</code></td>
												<td>
													if step.StartedAt != nil {
														{ step.StartedAt.Format("15:04:05") }
													} else {
														-
													}
												</td>
												<td>
													if step.StoppedAt != nil {
														{ step.StoppedAt.Format("15:04:05") }
													} else {
														-
													}
												</td>
												<td>
													if dur := step.Duration(); dur > 0 {
														{ dur.Round(time.Millisecond).String() }
													} else {
														-
													}
												</td>
											</tr>
											// Display logs for this step if any
											if step.Logs != nil && len(step.Logs.GetLogs()) > 0 {
												for _, logEntry := range step.Logs.GetLogs() {
													<tr class="step-log">
														<td></td>
														<td colspan="5" class="log-cell">
															<code class="log-message">{ logEntry.LogAt.Format("15:04:05") } { logEntry.Log }</code>
														</td>
													</tr>
												}
											}
										}
									</tbody>
								</table>
							}
							<h2>Snapshots</h2>
							<table class="snapshot-table">
								<thead>
									<tr>
										<th>Snapshot</th>
										<th class="sortable">Created</th>
										<th>Local</th>
										<th>Remote</th>
										<th class="sortable">Size</th>
									</tr>
								</thead>
								<tbody>
									// Create a union of local and remote snapshots
									@snapshotRows(ds)
								</tbody>
							</table>
						</div>
						// Logs are now displayed inline with the plan and steps
					} else {
						<p>Dataset not found.</p>
					}
				}
			</div>
			<script>
			// Table sorting functionality
			function makeSortable(table) {
				const headers = table.querySelectorAll('th.sortable');
				console.log('Found sortable headers:', headers.length);
				headers.forEach((header, index) => {
					const actualColumnIndex = Array.from(table.querySelectorAll('th')).indexOf(header);
					console.log(`Header ${index} (${header.textContent.trim()}) is at column ${actualColumnIndex}`);
					header.addEventListener('click', () => sortTable(table, actualColumnIndex));
				});
			}

			function sortTable(table, column) {
				const tbody = table.querySelector('tbody');
				const rows = Array.from(tbody.querySelectorAll('tr'));
				const header = table.querySelectorAll('th')[column];
				const headerText = header.textContent.trim().toLowerCase();

				// Special handling for dataset column only in the main overview table
				// (not in the snapshot table)
				if (column === 0 && headerText === 'dataset') {
					// Dataset column: toggle between name-length and lexical
					const isLexical = header.classList.contains('sort-asc');

					// Remove previous sort classes
					table.querySelectorAll('th').forEach(th => {
						th.classList.remove('sort-asc', 'sort-desc');
					});

					if (isLexical) {
						// Switch to name-length sort (default state, no indicator)
						rows.sort((a, b) => {
							const aVal = a.cells[0].textContent.trim();
							const bVal = b.cells[0].textContent.trim();

							// Always keep <root> at the top
							if (aVal === '<root>') return -1;
							if (bVal === '<root>') return 1;

							if (aVal.length === bVal.length) {
								return aVal.localeCompare(bVal);
							}
							return aVal.length - bVal.length;
						});
					} else {
						// Switch to lexical sort (show ascending indicator)
						header.classList.add('sort-asc');
						rows.sort((a, b) => {
							const aVal = a.cells[0].textContent.trim();
							const bVal = b.cells[0].textContent.trim();

							// Always keep <root> at the top
							if (aVal === '<root>') return -1;
							if (bVal === '<root>') return 1;

							return aVal.localeCompare(bVal);
						});
					}
				} else {
					// Other columns: normal asc/desc toggle
					const isAsc = !header.classList.contains('sort-asc');

					// Remove previous sort classes
					table.querySelectorAll('th').forEach(th => {
						th.classList.remove('sort-asc', 'sort-desc');
					});

					// Add current sort class
					header.classList.add(isAsc ? 'sort-asc' : 'sort-desc');

					// Sort rows
					rows.sort((a, b) => {
						let aVal = a.cells[column].textContent.trim();
						let bVal = b.cells[column].textContent.trim();

						// Debug: log values for problematic columns
						if (column === 4 || column === 5) {
							console.log(`Column ${column}: "${aVal}" vs "${bVal}"`);
						}

						// Handle dashes (no data)
						if (aVal === '-' && bVal === '-') return 0;
						if (aVal === '-') return isAsc ? 1 : -1;
						if (bVal === '-') return isAsc ? -1 : 1;

						// Check if values are sizes (contain 'B', 'KB', 'MB', etc.)
						// More flexible regex to handle whitespace and formatting
						if ((aVal.match(/\d+(\.\d+)?\s*[KMGTPE]?B/i) || aVal === '-') &&
						    (bVal.match(/\d+(\.\d+)?\s*[KMGTPE]?B/i) || bVal === '-')) {
							return compareSize(aVal, bVal) * (isAsc ? 1 : -1);
						}

						// Check if values are dates
						if (aVal.match(/\d{4}-\d{2}-\d{2}/) && bVal.match(/\d{4}-\d{2}-\d{2}/)) {
							return (new Date(aVal) - new Date(bVal)) * (isAsc ? 1 : -1);
						}

						// Check if values are numbers
						const aNum = parseFloat(aVal.replace(/[^0-9.-]/g, ''));
						const bNum = parseFloat(bVal.replace(/[^0-9.-]/g, ''));
						if (!isNaN(aNum) && !isNaN(bNum)) {
							return (aNum - bNum) * (isAsc ? 1 : -1);
						}

						// Default string comparison
						return aVal.localeCompare(bVal) * (isAsc ? 1 : -1);
					});
				}

				// Append sorted rows
				rows.forEach(row => tbody.appendChild(row));
			}

			function compareSize(a, b) {
				const units = { 'B': 1, 'KB': 1024, 'MB': 1024**2, 'GB': 1024**3, 'TB': 1024**4, 'PB': 1024**5, 'EB': 1024**6 };

				function parseSize(str) {
					const match = str.match(/([\d.]+)\s*([KMGTPE]?B)/);
					if (!match) return 0;
					return parseFloat(match[1]) * (units[match[2]] || 1);
				}

				return parseSize(a) - parseSize(b);
			}

			// Initialize sortable tables
			document.addEventListener('DOMContentLoaded', function() {
				document.querySelectorAll('table').forEach(makeSortable);
			});

			// Control buttons: any element with data-api posts to that
			// endpoint, optionally confirming first. The page refreshes via
			// the state-change poll.
			document.addEventListener('click', async function(e) {
				const btn = e.target.closest('button[data-api]');
				if (!btn) return;
				if (btn.dataset.confirm && !confirm(btn.dataset.confirm)) return;
				btn.disabled = true;
				try {
					const res = await fetch(btn.dataset.api, { method: 'POST' });
					if (!res.ok) alert(await res.text());
				} catch (err) {
					alert(err);
				} finally {
					btn.disabled = false;
				}
			});

			document.addEventListener('DOMContentLoaded', function() {
				const snapshotBtn = document.getElementById('snapshot-btn');
				if (snapshotBtn) {
					snapshotBtn.addEventListener('click', async function() {
						const periodicity = document.getElementById('snapshot-periodicity').value;
						if (!confirm(`Create a recursive ${periodicity} snapshot?`)) return;
						snapshotBtn.disabled = true;
						try {
							const res = await fetch(`/api/snapshot?periodicity=${periodicity}`, { method: 'POST' });
							if (!res.ok) alert(await res.text());
						} catch (err) {
							alert(err);
						} finally {
							snapshotBtn.disabled = false;
						}
					});
				}
			});

			// Config editor: preview renders the per-dataset impact of the
			// edited config without writing anything; save previews first and
			// asks for confirmation when the change schedules deletions.
			async function previewConfig() {
				const body = document.getElementById('config-editor').value;
				const el = document.getElementById('config-impacts');
				let res;
				try {
					res = await fetch('/api/config/preview', { method: 'POST', body });
				} catch (err) {
					el.innerHTML = '<pre class="config-error"></pre>';
					el.querySelector('pre').textContent = String(err);
					return null;
				}
				if (!res.ok) {
					el.innerHTML = '<pre class="config-error"></pre>';
					el.querySelector('pre').textContent = await res.text();
					return null;
				}
				const data = await res.json();
				renderImpacts(data.impacts);
				return data.impacts;
			}

			function renderImpacts(impacts) {
				const el = document.getElementById('config-impacts');
				if (!impacts.length) {
					el.innerHTML = '<p class="impact-note">Valid config. No dataset’s retention target changes.</p>';
					return;
				}
				const rows = impacts.map(i => {
					const cells = [
						i.dataset,
						i.retentionOld === i.retentionNew ? i.retentionNew : `${i.retentionOld} → ${i.retentionNew}`,
						i.pausedOld === i.pausedNew ? (i.pausedNew ? 'paused' : '') : (i.pausedNew ? '→ paused' : '→ resumed'),
						i.localDeletions,
						i.remoteDeletions,
						i.transfers,
					];
					return '<tr>' + cells.map(c => `<td>${escapeHtml(String(c))}</td>`).join('') + '</tr>';
				}).join('');
				el.innerHTML = '<h2>Impact</h2><table><thead><tr>'
					+ '<th>dataset</th><th>retention</th><th>pause</th>'
					+ '<th>local deletions</th><th>remote deletions</th><th>transfers</th>'
					+ '</tr></thead><tbody>' + rows + '</tbody></table>';
			}

			function escapeHtml(s) {
				const div = document.createElement('div');
				div.textContent = s;
				return div.innerHTML;
			}

			document.addEventListener('DOMContentLoaded', function() {
				const previewBtn = document.getElementById('config-preview');
				const saveBtn = document.getElementById('config-save');
				if (previewBtn) previewBtn.addEventListener('click', previewConfig);
				if (saveBtn) saveBtn.addEventListener('click', async function() {
					const impacts = await previewConfig();
					if (impacts === null) return;
					const deletions = impacts.reduce((n, i) => n + i.localDeletions + i.remoteDeletions, 0);
					let msg = 'Save and apply this config?';
					if (impacts.length) {
						msg = `Save and apply? ${impacts.length} dataset(s) affected; ${deletions} snapshot(s) become scheduled for deletion.`;
					}
					if (!confirm(msg)) return;
					saveBtn.disabled = true;
					try {
						const res = await fetch('/api/config', { method: 'PUT', body: document.getElementById('config-editor').value });
						if (!res.ok) {
							alert(await res.text());
							return;
						}
						window.location.reload();
					} finally {
						saveBtn.disabled = false;
					}
				});
			});

			// Long-polling for state changes
			async function poll() {
				while (true) {
					try {
						const response = await fetch('/poll');
						if (response.ok) {
							// State changed, refresh the page
							window.location.reload();
							return;
						}
						// Timeout, poll again immediately
					} catch (error) {
						// Connection error, retry after a delay
						await new Promise(resolve => setTimeout(resolve, 5000));
					}
				}
			}

			// Start polling when the page loads — except on the config page,
			// where a reload would clobber an in-progress edit.
			document.addEventListener('DOMContentLoaded', function() {
				if (window.location.pathname !== '/config') {
					poll();
				}
			});
		</script>
		</body>
	</html>
}

templ renderDatasetLink(ds model.DatasetName, dataset *model.Dataset, syncStatus *sync.Status, conf *config.Config, currentDataset string) {
	// Create a URL-safe path for the dataset
	// For the special root dataset, we need a special case
	if ds.String() == "<root>" {
		<a href={ templ.SafeURL("/root") } class={ "dataset-link", templ.KV("active", ds.String() == currentDataset) }>
			@renderSyncIndicator(ds, dataset, syncStatus, conf.PausedFor(ds.Path()))
			<div class="dataset-info">
				<div class="dataset-name">{ ds.String() }</div>
				@renderDatasetSize(dataset)
			</div>
			<span class={ "status", templ.KV("stale", dataset.Staleness() > time.Minute*10) }>
				{ dataset.Staleness().Truncate(time.Minute).String() }
			</span>
		</a>
	} else {
		// For normal datasets, create a URL using just the dataset name without the leading slash
		// This allows the URL router to handle it properly
		<a href={ templ.SafeURL("/" + ds.String()[1:]) } class={ "dataset-link", templ.KV("active", ds.String() == currentDataset) }>
			@renderSyncIndicator(ds, dataset, syncStatus, conf.PausedFor(ds.Path()))
			<div class="dataset-info">
				<div class="dataset-name">{ ds.String() }</div>
				@renderDatasetSize(dataset)
			</div>
			<span class={ "status", templ.KV("stale", dataset.Staleness() > time.Minute*10) }>
				{ dataset.Staleness().Truncate(time.Minute).String() }
			</span>
		</a>
	}
}

templ renderSyncIndicator(ds model.DatasetName, dataset *model.Dataset, syncStatus *sync.Status, paused bool) {
	if syncStatus.IsSyncing(ds) {
		<span class="sync-indicator syncing" title="Currently syncing"></span>
	} else if paused {
		<span class="sync-indicator paused" title="Paused"></span>
	} else if dataset.Staleness() > time.Minute*10 {
		<span class="sync-indicator stale" title="Stale - needs sync"></span>
	} else {
		<span class="sync-indicator synced" title="Up to date"></span>
	}
}

templ renderDatasetSize(dataset *model.Dataset) {
	<div class="dataset-size">
		if dataset.Metrics.HasLocal {
			Local: { dataset.Metrics.LocalSize.HumanizedUsed() }
		}
		if dataset.Metrics.HasRemote {
			if dataset.Metrics.HasLocal {
				<br/>
			}
			Remote: { dataset.Metrics.RemoteSize.HumanizedUsed() }
		}
		if !dataset.Metrics.HasLocal && !dataset.Metrics.HasRemote {
			No size info
		}
	</div>
}

templ renderStepStatus(status model.StepStatus) {
	switch status {
		case model.StepPending:
			<span class="step-status pending" title="Pending"></span>
		case model.StepInProgress:
			<span class="step-status in-progress" title="In Progress"></span>
		case model.StepCompleted:
			<span class="step-status completed" title="Completed"></span>
		case model.StepFailed:
			<span class="step-status failed" title="Failed"></span>
	}
}

templ snapshotRows(ds *model.Dataset) {
	// Create a union of snapshots
	if ds.Current != nil {
		for snap := range ds.Current.Local.Union(ds.Current.Remote).AllDesc() {
			<tr>
				<td>{ snap.Name }</td>
				<td>{ snap.Time().Format(time.DateTime) }</td>
				<td>
					@snapshotPresence(ds.Current.Local.Has(snap), targetHas(ds.Target, model.Local, snap), ds.Target != nil)
				</td>
				<td>
					@snapshotPresence(ds.Current.Remote.Has(snap), targetHas(ds.Target, model.Remote, snap), ds.Target != nil)
				</td>
				<td><code>{ snap.SizeString() }</code></td>
			</tr>
		}
	}
}

// snapshotPresence renders one location cell: present (✓), present but
// scheduled for deletion (orange ✓), missing but scheduled for transfer
// (✗), or not wanted (-).
templ snapshotPresence(current bool, inTarget bool, hasTarget bool) {
	if current {
		if hasTarget && !inTarget {
			<span class="snapshot-doomed" title="Present; scheduled for deletion">✓</span>
		} else {
			<span class="snapshot-present">✓</span>
		}
	} else if inTarget {
		<span class="snapshot-absent" title="Missing; scheduled for transfer">✗</span>
	} else {
		<span>-</span>
	}
}

templ renderRetention(conf *config.Config, dataset string) {
	if _, override := conf.OverrideFor(dataset); override != nil {
		<code class="retention-override">{ conf.RetentionDescription(dataset) }</code>
	} else {
		<code>default</code>
	}
}
