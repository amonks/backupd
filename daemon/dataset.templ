package daemon

import (
	"fmt"
	"time"

	"monks.co/backupd/history"
	"monks.co/backupd/logger"
	"monks.co/backupd/model"
	"monks.co/backupd/status"
	"monks.co/backupd/view"
	"monks.co/pkg/localtime"
)

// datasetPage is one dataset's detail view, ordered by what an
// operator checks: is it healthy and what could I recover (the
// recovery sentence), the assurance facts, retention fulfillment,
// then the plan with live progress, the snapshot grid, and logs.
templ datasetPage(d pageData) {
	{{ name := model.DatasetName(d.Page) }}
	{{ ds := d.State.GetDataset(name) }}
	{{ dv, _ := d.Sys.Get(name) }}
	if ds == nil {
		<h1>{ name.String() }</h1>
		<p>Dataset not found.</p>
	} else {
		<h1>
			{ name.String() }
			<span class={ "chip", "chip-" + dv.Health.Class() }>{ dv.Health.String() }</span>
			if dv.Syncing {
				<span class="spinner" title={ syncingTitle(dv) }></span>
			}
		</h1>
		<div class="controls-row" style="display: flex; gap: 0.5rem; margin-bottom: 1rem;">
			if d.Conf.SubtreePaused(name.Path()) {
				<button class="btn warn" data-api={ "/api/resume?dataset=" + name.Path() }>Resume dataset</button>
			} else {
				<button class="btn" data-api={ "/api/pause?dataset=" + name.Path() } data-confirm={ "Pause syncing for " + name.String() + " and everything under it?" }>Pause dataset</button>
			}
			<button class="btn" data-api={ "/api/sync?dataset=" + name.Path() }>Sync now</button>
		</div>
		@recoverySentence(dv)
		@factsTable(d, name, dv)
		@fulfillmentTable(dv)
		@planSection(d, name, ds)
		<h2>Snapshots</h2>
		@snapshotsGrid(ds)
		{{ events := eventsForDataset(d.Events, name) }}
		if len(events) > 0 {
			<h2>Journal</h2>
			@journalGrid(d.Base, events)
		}
	}
}

// recoverySentence answers the operator's core question in words: if
// the local pool were lost right now, what could be recovered?
templ recoverySentence(dv view.Dataset) {
	if dv.HasRemote {
		<p class={ "recovery", templ.KV("atrisk", dv.BackupStale) }>
			If the local pool were lost now, this dataset could be restored as of
			<b>
				@localtime.Stamp(dv.NewestRemote, localtime.Minute)
				{ " (" + fmtCompactDuration(dv.BackedUp) + " ago)" }
			</b>.
			{ "History reaches back " + fmtCompactDuration(dv.Depth) + ", to " }
			@localtime.Stamp(dv.OldestRemote, localtime.Day)
			{ "." }
			if dv.BackupStale {
				That is older than expected for its cadence.
			}
		</p>
	} else if dv.HasLocal {
		<p class="recovery atrisk">
			<b>This dataset has never been replicated:</b> nothing could be
			recovered were the local pool lost.
			if dv.PendingTransfers > 0 {
				Its initial transfer is queued.
			}
		</p>
	} else {
		<p class="recovery muted">No snapshots exist on either side yet.</p>
	}
}

templ factsTable(d pageData, name model.DatasetName, dv view.Dataset) {
	<table class="facts">
		if dv.Reason != "" {
			<tr>
				<th>Status</th>
				<td>{ dv.Health.String() }: { dv.Reason }</td>
			</tr>
		}
		<tr>
			<th>Snapshotted</th>
			<td>
				if dv.HasLocal {
					<span class={ templ.KV("stale-text", dv.SnapshotsStale) }>
						@localtime.Titled(dv.NewestLocal, localtime.Second) {
							{ fmtCompactDuration(dv.Snapshotted) + " ago" }
						}
					</span>
					if dv.Cadence > 0 {
						<span class="muted">(expected every { fmtCompactDuration(dv.Cadence) })</span>
					}
				} else {
					<span class="error-text">no local snapshots</span>
				}
			</td>
		</tr>
		<tr>
			<th>Backed up</th>
			<td>
				if dv.HasRemote {
					<span class={ templ.KV("stale-text", dv.BackupStale) }>
						@localtime.Titled(dv.NewestRemote, localtime.Second) {
							{ fmtCompactDuration(dv.BackedUp) + " ago" }
						}
					</span>
					if dv.Lag > 0 {
						<span class="muted">({ fmtCompactDuration(dv.Lag) } behind local)</span>
					}
					if dv.BackupCadence > 0 {
						<span class="muted">(expected every { fmtCompactDuration(dv.BackupCadence) })</span>
					}
				} else {
					<span class="error-text">never</span>
				}
			</td>
		</tr>
		<tr>
			<th>Last sync run</th>
			<td>
				if dv.LastFailure != nil && (dv.LastSuccess.IsZero() || dv.LastFailure.At.After(dv.LastSuccess)) {
					<span class="error-text">
						{ "failed " }
						@whenCell(dv.LastFailure.At)
					</span>
					&nbsp;<code class="error-text">{ dv.LastFailure.Error }</code>
				} else if !dv.LastSuccess.IsZero() {
					<span>
						{ "succeeded " }
						@whenCell(dv.LastSuccess)
					</span>
				} else {
					<span class="muted">none since the daemon started</span>
				}
			</td>
		</tr>
		if dv.LastFailure != nil && !dv.LastSuccess.IsZero() && dv.LastSuccess.After(dv.LastFailure.At) {
			<tr>
				<th>Last failure</th>
				<td class="muted">
					@whenCell(dv.LastFailure.At)
					&nbsp;<code>{ dv.LastFailure.Error }</code>
				</td>
			</tr>
		}
		{{ ds := d.State.GetDataset(name) }}
		<tr>
			<th>Local</th>
			<td>
				{ fmt.Sprint(dv.LocalCount) } snapshots
				· { fmtBytes(dv.LocalUsed) } on disk
				if ds != nil && ds.Metrics.HasLocal {
					· { fmtBytes(ds.Metrics.LocalSize.LogicalReferenced) } logical
				}
			</td>
		</tr>
		<tr>
			<th>Remote</th>
			<td>
				{ fmt.Sprint(dv.RemoteCount) } snapshots
				· { fmtBytes(dv.RemoteUsed) } on disk
				if ds != nil && ds.Metrics.HasRemote {
					· { fmtBytes(ds.Metrics.RemoteSize.LogicalReferenced) } logical
				}
			</td>
		</tr>
		<tr>
			<th>Retention</th>
			<td>
				@renderRetention(d.Conf, name.Path())
			</td>
		</tr>
		if dv.Paused {
			<tr>
				<th>Paused</th>
				<td>
					if dv.GlobalPaused {
						<span class="chip chip-paused">yes — global pause</span>
					} else {
						<span class="chip chip-paused">yes</span>
					}
				</td>
			</tr>
		}
	</table>
}

// fulfillmentTable compares policy with what each side actually holds,
// per periodicity. Shortfalls are highlighted but are display-only: a
// young dataset legitimately has fewer snapshots than policy wants.
templ fulfillmentTable(dv view.Dataset) {
	if len(dv.Fulfillment) > 0 {
		<h2>Retention Fulfillment</h2>
		<div class="table-scroll">
			<table style="max-width: 32rem;">
				<thead>
					<tr>
						<th>periodicity</th>
						<th class="num">local (have / want)</th>
						<th class="num">remote (have / want)</th>
					</tr>
				</thead>
				<tbody>
					for _, row := range dv.Fulfillment {
						<tr>
							<td>{ row.Periodicity }</td>
							<td class="num">
								@fulfillmentCell(row.LocalHave, row.LocalWant)
							</td>
							<td class="num">
								@fulfillmentCell(row.RemoteHave, row.RemoteWant)
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

templ fulfillmentCell(have, want int) {
	if want == 0 {
		<span class="muted">{ fmt.Sprint(have) } / —</span>
	} else if have < want {
		<span class="shortfall">{ fmt.Sprint(have) } / { fmt.Sprint(want) }</span>
	} else {
		{ fmt.Sprint(have) } / { fmt.Sprint(want) }
	}
}

// planSection shows the transition plan with per-step status and, for
// the in-flight step, a live progress bar.
templ planSection(d pageData, name model.DatasetName, ds *model.Dataset) {
	if ds.Plan != nil && len(ds.Plan.Steps) > 0 {
		{{ dv, _ := d.Sys.Get(name) }}
		<h2>
			Plan
			<span class="muted" style="font-weight: normal;">
				— { fmt.Sprint(len(ds.Plan.Steps)) } steps, { fmt.Sprint(dv.StepsDone) } done
			</span>
		</h2>
		<div class="table-scroll">
			<table>
				<thead>
					<tr>
						<th class="num">#</th>
						<th>status</th>
						<th>operation</th>
						<th>started</th>
						<th class="num">duration</th>
					</tr>
				</thead>
				<tbody>
					for i, step := range ds.Plan.Steps {
						<tr>
							<td class="num">{ fmt.Sprint(i + 1) }</td>
							<td>
								@renderStepStatus(step.Status)
							</td>
							<td><code>{ step.String() }</code></td>
							<td>
								if step.StartedAt != nil {
									@localtime.Stamp(*step.StartedAt, localtime.Second)
								} else {
									<span class="muted">—</span>
								}
							</td>
							<td class="num">
								if dur := step.Duration(); dur > 0 {
									{ dur.Round(time.Millisecond).String() }
								} else {
									<span class="muted">—</span>
								}
							</td>
						</tr>
						if step.Status == model.StepInProgress && d.Activity.Phase == status.Syncing && d.Activity.Dataset == name && d.Activity.Transfer != nil {
							<tr class="step-progress">
								<td></td>
								<td colspan="4">
									<progress max="100" value={ fmt.Sprintf("%.1f", d.Activity.Transfer.Percent()) }></progress>
									<span class="progress-label">{ transferLabel(*d.Activity.Transfer) }</span>
								</td>
							</tr>
						}
						{{ var stepLogs []logger.LogEntry }}
						{{ if step.Logs != nil { stepLogs = step.Logs.GetLogs() } }}
						if len(stepLogs) > 0 {
							{{ logs, elided := tailLogs(stepLogs, stepLogTail) }}
							if elided > 0 {
								<tr class="step-log">
									<td></td>
									<td colspan="4">
										<code class="log-message muted">… { fmt.Sprint(elided) } earlier lines (full record in the process log)</code>
									</td>
								</tr>
							}
							for _, logEntry := range logs {
								<tr class="step-log">
									<td></td>
									<td colspan="4">
										<code class="log-message">
											@localtime.Stamp(logEntry.LogAt, localtime.Second)
											{ " " + logEntry.Log }
										</code>
									</td>
								</tr>
							}
						}
					}
				</tbody>
			</table>
		</div>
	}
}

templ renderStepStatus(st model.StepStatus) {
	switch st {
		case model.StepPending:
			<span class="step-status pending" title="Pending"></span>
		case model.StepInProgress:
			<span class="step-status in-progress" title="In progress"></span>
		case model.StepCompleted:
			<span class="step-status completed" title="Completed"></span>
		case model.StepFailed:
			<span class="step-status failed" title="Failed"></span>
	}
}

// stepLogTail bounds how many of a plan step's log lines render
// inline: the tail is what matters for a live transfer (current
// throughput), and a long transfer logs a line a minute — the full
// record is in the process log.
const stepLogTail = 12

// tailLogs returns the last n entries and how many were elided.
func tailLogs(logs []logger.LogEntry, n int) ([]logger.LogEntry, int) {
	if len(logs) <= n {
		return logs, 0
	}
	return logs[len(logs)-n:], len(logs) - n
}

// eventsForDataset filters the journal to one dataset's entries.
func eventsForDataset(events []history.Event, name model.DatasetName) []history.Event {
	var out []history.Event
	for _, e := range events {
		if e.Dataset != nil && *e.Dataset == name {
			out = append(out, e)
		}
	}
	return out
}
