package daemon

import (
	"fmt"
	"time"

	"monks.co/backupd/history"
	"monks.co/backupd/status"
	"monks.co/backupd/view"
)

// overview is the operator's landing page, ordered by session
// frequency: what needs attention (or all clear), what is happening
// right now, the fleet's assurance table, then the record of what the
// daemon has done — the journal of notable transitions, executed
// operations, and the cycle history collapsed into runs.
templ overview(d pageData) {
	<h1>Overview</h1>
	@attentionSection(d)
	@nowSection(d)
	@fleetGrid(d.Base, d.Sys.Datasets)
	@recordSection(d)
}

// attentionSection leads with the typed issue list — everything wrong,
// worst first, each with its remedy inline — or an explicit all-clear.
templ attentionSection(d pageData) {
	if len(d.Sys.Issues) == 0 {
		<p class="all-clear">All clear — every dataset is snapshotted, replicated, and within policy.</p>
	} else {
		<div class="issues">
			for _, issue := range d.Sys.Issues {
				@issueCard(d.Base, issue)
			}
		</div>
	}
}

templ issueCard(base string, issue view.Issue) {
	<div class={ "issue", "issue-" + issue.Severity.String() }>
		<span class={ "chip", "chip-" + issue.Severity.String() }>{ issue.Severity.String() }</span>
		if issue.Dataset != nil {
			<a href={ templ.SafeURL(datasetHref(base, *issue.Dataset)) }>{ issue.Dataset.String() }</a>
		}
		<span class="issue-summary">{ issue.Summary }</span>
		if !issue.Since.IsZero() {
			<span class="issue-since" title={ exactTime(issue.Since) }>since { fmtAgo(issue.Since) }</span>
		}
		@issueAction(issue)
		if issue.Detail != "" {
			<span class="issue-detail">{ issue.Detail }</span>
		}
	</div>
}

// issueAction offers the remedy next to the problem: resume what is
// paused, retry what is failing.
templ issueAction(issue view.Issue) {
	switch issue.Kind {
		case view.IssuePaused:
			if issue.Dataset == nil {
				<button class="btn small warn" data-api="/api/resume">Resume all</button>
			} else {
				<button class="btn small warn" data-api={ "/api/resume?dataset=" + issue.Dataset.Path() }>Resume</button>
			}
		case view.IssueFailing, view.IssueStaleBackup, view.IssueUnreplicated:
			if issue.Dataset != nil {
				<button class="btn small" data-api={ "/api/sync?dataset=" + issue.Dataset.Path() }>Sync now</button>
			}
		case view.IssueCycleFailing:
			<button class="btn small" data-api="/api/sync">Sync now</button>
	}
}

// nowSection answers "where in the cycle are we": the queue as a dot
// per dataset while a cycle runs, the countdown while waiting.
templ nowSection(d pageData) {
	{{ c := d.Sys.Cycle }}
	switch d.Activity.Phase {
		case status.Refreshing:
			<div class="now"><span class="spinner"></span> refreshing datasets from ZFS…</div>
		case status.Syncing:
			<div class="now">
				if c.Total > 0 {
					<span>dataset { fmt.Sprint(c.Position) } of { fmt.Sprint(c.Total) }</span>
					<span class="qdots">
						for _, e := range c.Entries {
							<span class={ "qdot", "qdot-" + e.State.String() } title={ e.Dataset.String() + ": " + e.State.String() }></span>
						}
					</span>
				}
				<span>{ activityLabel(d.Activity, c) }</span>
			</div>
		case status.Idle:
			<div class="now">
				<span>next cycle <span class="countdown" data-until={ fmt.Sprint(d.Activity.Until.UnixMilli()) }>{ fmtUntil(d.Activity.Until) }</span> (at { d.Activity.Until.Format("15:04") })</span>
				@lastCycleNote(d)
			</div>
		case status.BackingOff:
			<div class="now">
				<span class="error-text">{ activityLabel(d.Activity, c) }</span>
				<span>retrying <span class="countdown" data-until={ fmt.Sprint(d.Activity.Until.UnixMilli()) }>{ fmtUntil(d.Activity.Until) }</span></span>
			</div>
	}
}

templ lastCycleNote(d pageData) {
	if c := d.Sys.LastCycle; c != nil && c.OK && !c.Paused {
		<span class="muted">last cycle finished { fmtAgo(c.StoppedAt) } in { c.Duration().Round(time.Second).String() }</span>
	}
}

// ageCell renders an age with staleness highlighting, or the absent
// label ("never", "no snapshots").
templ ageCell(has bool, age time.Duration, stale bool, absent string) {
	if !has {
		<span class="error-text">{ absent }</span>
	} else if stale {
		<span class="stale-text">{ fmtCompactDuration(age) }</span>
	} else {
		{ fmtCompactDuration(age) }
	}
}

// recordSection is the account of what the daemon has done. The
// journal holds transitions and operator actions — when something
// broke, changed, or recovered — so it stays short no matter how long
// the daemon runs; the activity feed holds executed operations; the
// cycle history is a strip of recent checks plus consecutive
// same-outcome cycles collapsed into runs, so months of hourly checks
// read as a handful of rows.
templ recordSection(d pageData) {
	if len(d.Events) > 0 {
		<h2>Journal</h2>
		@journalGrid(d.Base, d.Events)
	}
	if len(d.Ops) > 0 {
		<h2>Recent Activity</h2>
		@opsGrid(d.Base, d.Ops)
	}
	if len(d.Cycles) > 0 {
		<h2>Cycle History</h2>
		@cycleStrip(d.Cycles)
		@runsGrid(d.Sys.Runs)
	}
}

// stripLen bounds the cycle strip: at an hourly interval, a few days
// at a glance. Older cycles are still in the runs table.
const stripLen = 96

// stripCycles returns up to n of the newest cycles, oldest first, for
// left-to-right rendering.
func stripCycles(cycles []history.Cycle, n int) []history.Cycle {
	if len(cycles) > n {
		cycles = cycles[:n]
	}
	out := make([]history.Cycle, len(cycles))
	for i, c := range cycles {
		out[len(cycles)-1-i] = c
	}
	return out
}

// stripClass maps a cycle outcome onto the queue-dot palette.
func stripClass(c history.Cycle) string {
	switch view.OutcomeOf(c) {
	case view.CyclePaused:
		return "skipped"
	case view.CycleOK:
		return "done"
	default:
		return "failed"
	}
}

func stripTitle(c history.Cycle) string {
	title := fmt.Sprintf("%s · %s in %s",
		c.StartedAt.Format(time.DateTime),
		view.OutcomeOf(c).String(),
		c.Duration().Round(time.Second))
	if d := view.CycleDetail(c); d != "" {
		title += " · " + d
	}
	return title
}

// cycleStrip shows recent cycles at a glance, one cell per cycle,
// oldest to newest.
templ cycleStrip(cycles []history.Cycle) {
	<div class="cycle-strip">
		for _, c := range stripCycles(cycles, stripLen) {
			<span class={ "qdot", "qdot-" + stripClass(c) } title={ stripTitle(c) }></span>
		}
	</div>
}

func exactTime(t time.Time) string {
	if t.IsZero() {
		return ""
	}
	return t.Format("2006-01-02 15:04:05")
}
