package daemon

// script is the dashboard's client-side behavior. All event handlers
// are delegated from `document` so they survive DOM replacement: state
// changes are applied by fetching the current page and swapping the
// body in place (preserving scroll positions) rather than reloading,
// which keeps the page readable while a sync is writing progress.
templ script() {
	<script>
	// ---- Mount point ---------------------------------------------------
	// Every request the page makes is relative to where the dashboard is
	// mounted, which the server wrote onto the root element. Reading it
	// from the DOM rather than baking it into this script keeps the
	// script a constant: the same bytes serve a root mount and a
	// proxied sub-path.
	const ROOT = document.currentScript.closest('.backupd');
	const BASE = ROOT.dataset.base || '';
	// ---- Countdowns ----------------------------------------------------
	// Elements with data-until (ms since epoch) tick down client-side.
	function formatUntil(ms) {
		let s = Math.floor(ms / 1000);
		if (s <= 0) return 'any moment';
		const d = Math.floor(s / 86400); s %= 86400;
		const h = Math.floor(s / 3600); s %= 3600;
		const m = Math.floor(s / 60); s %= 60;
		if (d > 0) return `in ${d}d${h > 0 ? h + 'h' : ''}`;
		if (h > 0) return `in ${h}h${m > 0 ? m + 'm' : ''}`;
		if (m > 0) return `in ${m}m${s > 0 ? s + 's' : ''}`;
		return `in ${s}s`;
	}
	setInterval(function() {
		document.querySelectorAll('[data-until]').forEach(el => {
			el.textContent = formatUntil(parseInt(el.dataset.until, 10) - Date.now());
		});
	}, 1000);

	// ---- Control buttons -----------------------------------------------
	// Any element with data-api posts to that endpoint, optionally
	// confirming first. The page updates via the state-change poll.
	document.addEventListener('click', async function(e) {
		const btn = e.target.closest('button[data-api]');
		if (!btn) return;
		if (btn.dataset.confirm && !confirm(btn.dataset.confirm)) return;
		btn.disabled = true;
		try {
			const res = await fetch(BASE + btn.dataset.api, { method: 'POST' });
			if (!res.ok) alert(await res.text());
		} catch (err) {
			alert(err);
		} finally {
			btn.disabled = false;
		}
	});

	document.addEventListener('click', async function(e) {
		if (!e.target.closest('#snapshot-btn')) return;
		const btn = e.target.closest('#snapshot-btn');
		const periodicity = document.getElementById('snapshot-periodicity').value;
		if (!confirm(`Create a recursive ${periodicity} snapshot?`)) return;
		btn.disabled = true;
		try {
			const res = await fetch(`${BASE}/api/snapshot?periodicity=${periodicity}`, { method: 'POST' });
			if (!res.ok) alert(await res.text());
		} catch (err) {
			alert(err);
		} finally {
			btn.disabled = false;
		}
	});

	// ---- Config editor -------------------------------------------------
	async function previewConfig() {
		const body = document.getElementById('config-editor').value;
		const el = document.getElementById('config-impacts');
		let res;
		try {
			res = await fetch(BASE + '/api/config/preview', { method: 'POST', body });
		} catch (err) {
			el.innerHTML = '<pre class="config-error"></pre>';
			el.querySelector('pre').textContent = String(err);
			return null;
		}
		if (!res.ok) {
			el.innerHTML = '<pre class="config-error"></pre>';
			el.querySelector('pre').textContent = await res.text();
			return null;
		}
		const data = await res.json();
		renderImpacts(data.impacts);
		return data.impacts;
	}

	function renderImpacts(impacts) {
		const el = document.getElementById('config-impacts');
		if (!impacts.length) {
			el.innerHTML = '<p class="impact-note">Valid config. No dataset’s retention target changes.</p>';
			return;
		}
		const rows = impacts.map(i => {
			const cells = [
				i.dataset,
				i.retentionOld === i.retentionNew ? i.retentionNew : `${i.retentionOld} → ${i.retentionNew}`,
				i.pausedOld === i.pausedNew ? (i.pausedNew ? 'paused' : '') : (i.pausedNew ? '→ paused' : '→ resumed'),
				i.localDeletions,
				i.remoteDeletions,
				i.transfers,
			];
			return '<tr>' + cells.map(c => `<td>${escapeHtml(String(c))}</td>`).join('') + '</tr>';
		}).join('');
		el.innerHTML = '<h2>Impact</h2><div class="table-scroll"><table><thead><tr>'
			+ '<th>dataset</th><th>retention</th><th>pause</th>'
			+ '<th>local deletions</th><th>remote deletions</th><th>transfers</th>'
			+ '</tr></thead><tbody>' + rows + '</tbody></table></div>';
	}

	function escapeHtml(s) {
		const div = document.createElement('div');
		div.textContent = s;
		return div.innerHTML;
	}

	document.addEventListener('click', async function(e) {
		if (e.target.closest('#config-preview')) {
			previewConfig();
			return;
		}
		const saveBtn = e.target.closest('#config-save');
		if (!saveBtn) return;
		const impacts = await previewConfig();
		if (impacts === null) return;
		const deletions = impacts.reduce((n, i) => n + i.localDeletions + i.remoteDeletions, 0);
		let msg = 'Save and apply this config?';
		if (impacts.length) {
			msg = `Save and apply? ${impacts.length} dataset(s) affected; ${deletions} snapshot(s) become scheduled for deletion.`;
		}
		if (!confirm(msg)) return;
		saveBtn.disabled = true;
		try {
			const res = await fetch(BASE + '/api/config', { method: 'PUT', body: document.getElementById('config-editor').value });
			if (!res.ok) {
				alert(await res.text());
				return;
			}
			window.location.reload();
		} finally {
			saveBtn.disabled = false;
		}
	});

	// ---- Live refresh --------------------------------------------------
	// Long-poll for state changes; on change, re-fetch the page and swap
	// the body in place, preserving sidebar/main scroll positions —
	// a full reload would lose them every few seconds during a sync.
	//
	// Grid search/filter/sort state lives in the URL (pkg/datagrid), so
	// it survives the swap; but a swap would still close an open facet
	// menu or clobber half-typed search text, so the refresh waits for
	// those. Only those: sort and pager clicks leave their button
	// focused, and treating any in-grid focus as busy would freeze the
	// dashboard until the next outside click. The wait is bounded —
	// a stalled dashboard that looks live is worse than a closed menu.
	function gridBusy() {
		if (document.querySelector('monks-datagrid details[open]')) return true;
		const a = document.activeElement;
		return !!(a && a.matches && a.matches('monks-datagrid input, monks-datagrid textarea'));
	}

	// The swap replaces the dashboard element, not the document body:
	// embedded in a host page, the body also holds chrome the daemon
	// does not own and must not throw away. Scroll positions are
	// restored for both shells — the standalone one scrolls its two
	// panes, the embedded one scrolls the window.
	async function refreshBody() {
		for (let i = 0; i < 40 && gridBusy(); i++) {
			await new Promise(resolve => setTimeout(resolve, 750));
		}
		const res = await fetch(location.href);
		if (!res.ok) return;
		const doc = new DOMParser().parseFromString(await res.text(), 'text/html');
		const fresh = doc.querySelector('.backupd');
		const current = document.querySelector('.backupd');
		if (!fresh || !current) return;
		const sidebar = current.querySelector('.sidebar');
		const main = current.querySelector('.main-content');
		const scrolls = {
			sidebar: sidebar ? sidebar.scrollTop : 0,
			main: main ? main.scrollTop : 0,
			window: window.scrollY,
		};
		current.replaceChildren(...fresh.childNodes);
		const newSidebar = current.querySelector('.sidebar');
		const newMain = current.querySelector('.main-content');
		if (newSidebar) newSidebar.scrollTop = scrolls.sidebar;
		if (newMain) newMain.scrollTop = scrolls.main;
		window.scrollTo(0, scrolls.window);
	}

	// The poll is a long one — the server holds it for five minutes —
	// which is the only thing pacing this loop while it succeeds. An
	// error response is not an exception, so anything that answers
	// immediately (a host's 401 once a session lapses, a 502 while the
	// daemon restarts) would spin here at network speed, forever, with
	// nothing to notice it but the load. So: back off on every
	// non-success, and stop entirely on a refusal, where retrying
	// cannot be what the operator wants — a reload puts them in front
	// of whatever their host does about signing in.
	async function poll() {
		while (true) {
			try {
				const response = await fetch(BASE + '/poll');
				if (response.status === 401 || response.status === 403) {
					location.reload();
					return;
				}
				if (response.ok && response.status === 200) {
					await refreshBody();
					continue;
				}
				if (response.status !== 204) {
					await new Promise(resolve => setTimeout(resolve, 5000));
				}
			} catch (error) {
				await new Promise(resolve => setTimeout(resolve, 5000));
			}
		}
	}

	// The config page doesn't auto-refresh: a swap would clobber an
	// in-progress edit.
	if (window.location.pathname !== BASE + '/config') {
		poll();
	}
	</script>
}
